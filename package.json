{
  "name": "mcp-studio",
  "version": "1.0.0",
  "description": "OpenAPI to MCP server compiler pipeline",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "mcp-studio": "./dist/cli.js"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "start": "node dist/actor/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "node dist/cli.js generate",
    "actor": "apify run --entrypoint start"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "apify": "^3.2.6",
    "archiver": "^7.0.1",
    "commander": "^12.1.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.4.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "apify-cli": "^1.7.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
